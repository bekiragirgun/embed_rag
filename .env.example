# Database Configuration
DATABASE_URL=postgresql://postgres@localhost:5432/embed_rag
DB_HOST=localhost
DB_PORT=5432
DB_NAME=embed_rag
DB_USER=postgres
DB_PASSWORD=postgres

# Model Configuration
EMBEDDING_MODEL_DEVICE=cuda
MODEL_CACHE_DIR=./model_cache
EMBEDDING_DIM=1024

# Pipeline Configuration
BATCH_SIZE=32
VECTOR_SEARCH_LIMIT=10
SIMILARITY_THRESHOLD=0.3

# Logging
LOG_LEVEL=INFO
LOG_FILE=pipeline.log

# PDF Processing
PDF_INPUT_DIR=./pdfs
CHUNKS_OUTPUT_DIR=./chunks
EMBEDDINGS_OUTPUT_DIR=./embeddings
